# Optional: only needed if you switch from local HF pipeline to the
# Hugging Face Inference API (faster, no local GPU needed for generation).
# Get a free token from https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN=your_token_here

# Which local generation model to load (small + free + CPU-friendly by default)
LLM_MODEL_NAME=google/flan-t5-base

# Which embedding model to use (free, runs locally via sentence-transformers)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
